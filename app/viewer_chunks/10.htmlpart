")}
body:after{content:"";position:fixed;inset:0;z-index:1;pointer-events:none;background:rgba(0,0,0,.18)}
button{font:inherit;color:inherit;cursor:pointer}.app{position:relative;z-index:2;height:100dvh;width:min(100%,900px);margin:auto;padding:calc(var(--native-safe-top,0px) + 4px) 14px calc(var(--native-safe-bottom,0px) + 4px);display:flex;flex-direction:column;gap:10px;overflow:hidden}
.header{display:flex;align-items:center;gap:12px;flex:0 0 auto}.logo{width:54px;height:54px;border-radius:13px;object-fit:cover;box-shadow:0 4px 15px #0008}.brand{min-width:0}.brand h1{font-size:clamp(24px,7vw,34px);line-height:1;margin:0;font-weight:850;white-space:nowrap}.brand p{margin:4px 0 0;color:#aaa;font-size:clamp(14px,4vw,18px)}
.toprow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;flex:0 0 auto}.topbtn{width:100%;min-width:0;height:48px;transition:transform .08s ease,box-shadow .08s ease,filter .08s ease;transform-origin:center;border-radius:16px;border:1px solid #4c4c4c;background:#151515;font-weight:820;font-size:clamp(13px,3.8vw,17px);display:flex;align-items:center;justify-content:center;gap:7px;box-shadow:0 5px 16px #0005}.topbtn svg{width:20px;height:20px;flex:none}.connect{background:linear-gradient(#378dff,#176cff);border:none}.connect.connected{background:linear-gradient(#2788e9,#1769b9)}.live{background:var(--green);border:none;color:#fff}.live.active{background:#118c4d}.disconnect{background:var(--red);border:none;color:#fff;font-size:clamp(11px,3.1vw,15px);gap:4px;white-space:nowrap;padding:0 6px}.disconnect svg{color:#fff;width:18px;height:18px;flex:none}.topbtn:active{transform:translateY(2px) scale(.985);box-shadow:inset 0 3px 7px #0008,0 2px 6px #0005;filter:brightness(.9)}.tab:active:not(:disabled),.small:active:not(:disabled),.action:active:not(:disabled){transform:translateY(2px) scale(.985);box-shadow:inset 0 3px 7px #0008,0 2px 6px #0005;filter:brightness(.9)}.topbtn:disabled{opacity:.48;cursor:default}.live:disabled,.disconnect:disabled{opacity:1}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:0 0 auto}.tab{transition:transform .08s ease,box-shadow .08s ease,filter .08s ease;transform-origin:center;height:44px;border-radius:15px;background:#151515;border:1px solid #4e4e4e;font-weight:800;font-size:16px}.tab.active{background:#242424;border-color:#787878}
.stats{display:grid;gap:8px;flex:0 0 auto}.stat{height:58px;border-radius:17px;background:var(--glass);border:1px solid var(--line);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);display:grid;grid-template-columns:50px 1fr;align-items:center;padding:0 18px;box-shadow:0 5px 16px #0005}.statIcon{font-size:27px}.statNum{font-size:26px;font-weight:850;line-height:.9}.statLabel{font-size:14px;color:#aaa;margin-top:5px}
.fileControls{flex:0 0 auto}.pathrow{display:flex;align-items:center;gap:14px;margin-bottom:8px}.small{transition:transform .08s ease,box-shadow .08s ease,filter .08s ease;transform-origin:center;height:41px;border-radius:15px;padding:0 16px;background:#151515;border:1px solid #4d4d4d;font-weight:750;color:#aaa}.small:disabled,.action:disabled{opacity:.48}.crumbs{font-size:17px;font-weight:850;display:flex;align-items:center;gap:6px;white-space:nowrap;overflow:hidden}.crumb{cursor:pointer}.sep{color:#777}.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.action{transition:transform .08s ease,box-shadow .08s ease,filter .08s ease;transform-origin:center;height:43px;border-radius:15px;background:#151515;border:1px solid #4d4d4d;font-weight:800;font-size:14px}
.content{position:relative;min-height:0;flex:1 1 auto;border-radius:19px;background:var(--glass);border:1px solid var(--line);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);overflow:hidden;box-shadow:0 6px 18px #0006}.view{position:absolute;inset:0}.filesView{display:flex;flex-direction:column}.panelTitle{font-size:18px;font-weight:850;padding:14px 15px 8px;flex:0 0 auto}.list{padding:0 10px 12px;display:grid;gap:7px;overflow:auto;min-height:0;overscroll-behavior:contain}.empty{flex:1;display:grid;place-items:center;text-align:center;color:#c1c1c5;padding:24px;font-size:15px}.item{min-height:58px;border-radius:14px;background:rgba(10,10,10,.80);border:1px solid #ffffff18;display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:9px;padding:8px 12px}.ico{font-size:25px}.name{font-weight:780;overflow-wrap:anywhere}.meta{font-size:12px;color:#aaa;margin-top:2px}.chev{font-size:25px;color:#aaa}.picActions{display:flex;gap:5px}.mini{background:#1c1c1c;border:1px solid #555;border-radius:10px;padding:7px 8px;font-weight:750;font-size:12px}
.liveView{display:none;background:#030303}.liveView.show{display:flex;align-items:center;justify-content:center}.liveView img{width:100%;height:100%;object-fit:contain;display:none}.liveView.has img{display:block}.livePlaceholder{text-align:center;color:#888;padding:24px}.liveView.has .livePlaceholder{display:none}.liveBadge{position:absolute;left:12px;top:12px;border:1px solid #ffffff24;border-radius:999px;background:#070909d9;padding:5px 9px;font-size:11px;font-weight:800;display:none}.liveView.running .liveBadge{display:block;color:#8aefb2}.liveBadge:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:#2ed177;margin-right:6px}.liveProfile{position:absolute;right:12px;top:12px;border:1px solid #ffffff20;border-radius:999px;background:#070909d9;padding:5px 9px;font-size:10px;color:#bbb;display:none}.liveView.running .liveProfile{display:block}
.infoView{display:none;padding:14px;overflow:auto}.infoView.show{display:block}.infoCard{display:grid;gap:9px}.infoRow{background:rgba(9,9,9,.78);border:1px solid #ffffff18;border-radius:14px;padding:12px}.infoKey{font-size:11px;color:#999;text-transform:uppercase;letter-spacing:.08em}.infoVal{font-weight:800;margin-top:3px}
.progress{height:4px;border-radius:999px;background:#ffffff1f;overflow:hidden;display:none;flex:0 0 auto}.progress.show{display:block}.bar{height:100%;width:0;background:#2f86ff}.toast{position:absolute;z-index:80;left:50%;bottom:4px;transform:translateX(-50%);max-width:min(calc(100% - 16px),600px);background:#090909f4;border:1px solid #555;border-radius:13px;padding:10px 13px;color:#ddd;opacity:0;pointer-events:none;transition:.18s}.toast.show{opacity:1}
.modal{position:fixed;z-index:90;inset:0;background:#000e;display:none;align-items:center;justify-content:center;padding:12px}.modal.open{display:flex}.modalbox{display:flex;flex-direction:column;gap:9px;max-width:96vw;max-height:96vh}.modalbar{display:flex;gap:8px;align-items:center}.modalname{flex:1;overflow-wrap:anywhere}.modal img{max-width:94vw;max-height:82vh;object-fit:contain;border-radius:11px;background:#000}
@media(max-height:720px){.app{position:relative;z-index:2;gap:7px;padding-top:calc(env(safe-area-inset-top,0px) + 8px)}.header .logo{width:46px;height:46px}.brand h1{font-size:23px}.brand p{font-size:13px}.topbtn{height:43px}.tab{height:40px}.stat{height:52px}.statNum{font-size:23px}.statLabel{font-size:12px}.small{height:37px}.action{height:39px}.panelTitle{padding-top:10px}}

/* ~50% 3D depth treatment for interactive buttons */
.topbtn,.tab,.small,.action{
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,.34),
    inset 0 -3px 0 rgba(0,0,0,.34),
    0 4px 0 rgba(0,0,0,.34),
    0 9px 16px rgba(0,0,0,.24);
}
.topbtn:active,
.tab:active:not(:disabled),
.small:active:not(:disabled),
.action:active:not(:disabled){
  transform:translateY(2px) scale(.985);
  box-shadow:
    inset 0 4px 8px rgba(0,0,0,.42),
    inset 0 1px 0 rgba(255,255,255,.10),
    0 1px 2px rgba(0,0,0,.16);
  filter:brightness(.9);
}


/* Match file-control buttons to the actual rendered glass of the main viewing box */
#fileControls .small,
#fileControls .action{
  background:rgba(18,18,18,.64);
  backdrop-filter:blur(5px);
  -webkit-backdrop-filter:blur(5px);
  border-color:var(--line);
}

/* Match file-control text to the viewing-box text */
#fileControls .small,
#fileControls .action{
  color:#c1c1c5;
}

/* Simulated disabled state: still pressable visually, but actions remain blocked */
#fileControls .small.ui-disabled,
#fileControls .action.ui-disabled{
  opacity:1;
  color:#c1c1c5;
  cursor:default;
}

</style>
</head>
<body>
<script>document.body.classList.add('wallpaper-'+(1+Math.floor(Math.random()*10)));</script>
<div class="app">
  <header class="header"><img class="logo" src="data:image/png;base64,