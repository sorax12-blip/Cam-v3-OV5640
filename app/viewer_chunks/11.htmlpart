" alt="ESP32 Cam HD"><div class="brand"><h1>ESP32 Cam HD</h1><p>BLE Photo Viewer</p></div></header>

  <div class="toprow">
    <button id="connectBtn" class="topbtn connect"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 7l10 10-5 5V2l5 5L7 17"/></svg><span>Connect</span></button>
    <button id="liveBtn" class="topbtn live" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M8 6l1.5-2h5L16 6"/><circle cx="12" cy="13" r="4"/></svg><span>Live</span></button>
    <button id="disconnectBtn" class="topbtn disconnect" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 7l10 10-5 5V2l5 5L7 17"/><path d="M3 3l18 18"/></svg><span>Disconnected</span></button>
  </div>

  <div class="tabs"><button id="filesTab" class="tab active">Files</button><button id="infoTab" class="tab">Info</button></div>
  <div id="progress" class="progress"><div id="bar" class="bar"></div></div>

  <div class="stats">
    <div class="stat"><div class="statIcon">📁</div><div><div id="folderValue" class="statNum">0</div><div class="statLabel">folders indexed</div></div></div>
    <div class="stat"><div class="statIcon">🖼️</div><div><div id="picValue" class="statNum">0</div><div class="statLabel">pictures</div></div></div>
  </div>

  <div id="fileControls" class="fileControls">
    <div class="pathrow"><button id="upBtn" class="small ui-disabled" aria-disabled="true" data-ui-disabled="1">← Up</button><div id="crumbs" class="crumbs"></div></div>
    <div class="actions"><button id="refreshBtn" class="action ui-disabled" aria-disabled="true" data-ui-disabled="1">Refresh folder</button><button id="reindexBtn" class="action ui-disabled" aria-disabled="true" data-ui-disabled="1">Re-index card</button></div>
  </div>

  <main class="content">
    <section id="filesView" class="view filesView"><div id="panelTitle" class="panelTitle">/</div><div id="list" class="list"></div><div id="empty" class="empty">Connect to the camera to browse the SD card.</div></section>
    <section id="liveView" class="view liveView"><img id="liveImage" alt="Live camera preview"><div class="livePlaceholder">Connect to the camera, then tap <b>Live</b>.</div><div class="liveBadge">LIVE</div><div class="liveProfile">HVGA 480×320 • Q20 • ~4 FPS</div></section>
    <section id="infoView" class="view infoView"><div class="infoCard"><div class="infoRow"><div class="infoKey">BLE Device</div><div class="infoVal">ESP32 Cam HD</div></div><div class="infoRow"><div class="infoKey">Detected Camera</div><div id="sensorInfo" class="infoVal">—</div></div><div class="infoRow"><div class="infoKey">Live Profile</div><div class="infoVal">HVGA 480×320 • JPEG Q20 • 250 ms target</div></div><div class="infoRow"><div class="infoKey">Live Frames</div><div class="infoVal">RAM-only • never saved to SD</div></div></div></section>
    <div id="toast" class="toast"></div>
  </main>
</div>
<div id="modal" class="modal"><div class="modalbox"><div class="modalbar"><div id="modalName" class="modalname"></div><button id="closeModal" class="small">Close</button></div><img id="previewImg" alt="Picture preview"></div></div>
<script>
(()=>{'use strict';
const VIEWER_BUILD='UI Refresh Final v1 • APK Native BLE';
const DEVICE='ESP32 Cam HD',SERVICE='b6a30001-6e8c-4b74-a4c2-3b33d2c7a001',COMMAND='b6a30002-6e8c-4b74-a4c2-3b33d2c7a001',STATUS='b6a30003-6e8c-4b74-a4c2-3b33d2c7a001',DATA='b6a30004-6e8c-4b74-a4c2-3b33d2c7a001';
const LIVE_PROFILE='HVGA',LIVE_QUALITY=20,LIVE_INTERVAL=250;
const native=!!window.AndroidBridge;
const $=id=>document.getElementById(id),enc=new TextEncoder(),dec=new TextDecoder();
let device=null,gatt=null,cmd=null,statusChar=null,dataChar=null,connected=false,live=false,statusBuf='',sensor='—';
let folders=new Map(),currentPath='/',currentItems=[],activeListPath=null,transfer=null,previewUrl=null;
let liveRx=null,liveObjectUrl=null,toastTimer=null,currentView='files';

function toast(s,sticky=false){const t=$('toast');clearTimeout(toastTimer);if(!s){t.classList.remove('show');return}t.textContent=s;t.classList.add('show');if(!sticky)toastTimer=setTimeout(()=>t.classList.remove('show'),2600)}
function normalize(p){if(!p||p==='/')return '/';p=p.replace(/\\/g,'/').replace(/\/+/g,'/');if(!p.startsWith('/'))p='/'+p;return p.length>1?p.replace(/\/$/,''):p}
function parentOf(p){p=normalize(p);if(p==='/')return null;const i=p.lastIndexOf('/');return i<=0?'/':p.slice(0,i)}
function basename(p){p=normalize(p);return p==='/'?'/':p.slice(p.lastIndexOf('/')+1)}
function fmt(n){n=+n||0;if(n<1024)return n+' B';if(n<1048576)return(n/1024).toFixed(1)+' KB';return(n/1048576).toFixed(1)+' MB'}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function b64(bytes){let s='',step=32768;for(let i=0;i<bytes.length;i+=step)s+=String.fromCharCode.apply(null,bytes.subarray(i,i+step));return btoa(s)}

function setFileControlDisabled(id,v){
  const b=$(id);
  b.dataset.uiDisabled=v?'1':'0';
  b.setAttribute('aria-disabled',v?'true':'false');
  b.classList.toggle('ui-disabled',v);
}
function fileControlDisabled(id){return $(id).dataset.uiDisabled==='1'}

function setConnected(v){
  connected=v;
  $('connectBtn').disabled=v;
  $('disconnectBtn').disabled=!v;
  $('liveBtn').disabled=!v;
  setFileControlDisabled('refreshBtn',!v||live);
  setFileControlDisabled('reindexBtn',!v||live);
  setFileControlDisabled('upBtn',!v||live||currentPath==='/');
  $('connectBtn').classList.toggle('connected',v);
  $('connectBtn').querySelector('span').textContent=v?'Connected':'Connect';
  $('disconnectBtn').querySelector('span').textContent=v?'Disconnect':'Disconnected';
  if(!v){live=false;updateLiveButton();showView('files')}
}
function updateLiveButton(){
  $('liveBtn').classList.toggle('active',live);
  $('liveBtn').querySelector('span').textContent=live?'Stop Live':'Live';
  $('liveView').classList.toggle('running',live);
  setFileControlDisabled('refreshBtn',!connected||live);
  setFileControlDisabled('reindexBtn',!connected||live);
  setFileControlDisabled('upBtn',!connected||live||currentPath==='/');
}
function showView(v){
  currentView=v;
  $('filesView').style.display=v==='files'?'flex':'none';
  $('infoView').classList.toggle('show',v==='info');
  $('liveView').classList.toggle('show',v==='live');
  $('filesTab').classList.toggle('active',v==='files');
  $('infoTab').classList.toggle('active',v==='info');
  $('fileControls').style.visibility=v==='live'?'hidden':'visible'
}

async function send(s){
  if(!connected)throw new Error('Not connected');
  if(native){window.AndroidBridge.sendCommand(s);return}
  if(!cmd)throw new Error('Not connected');
  const b=enc.encode(s);
  if(cmd.writeValueWithoutResponse)await cmd.writeValueWithoutResponse(b);else await cmd.writeValue(b)
}

async function connectedStartup(){
  setConnected(true);
  folders.clear();currentItems=[];$('folderValue').textContent='0';$('picValue').textContent='0';render();
  toast('Connected');
  try{await send('LIVE INFO');await send('INDEX')}catch(e){toast(e&&e.message?e.message:String(e),true)}
}

async function connect(){
  if(native){toast('Scanning for ESP32 Cam HD…',true);window.AndroidBridge.connect();return}
  if(!navigator.bluetooth){toast('Web Bluetooth is unavailable. Use Chrome on Android in a secure/local context.',true);return}
  try{
    toast('Scanning for ESP32 Cam HD…',true);
    device=await navigator.bluetooth.requestDevice({filters:[{name:DEVICE}],optionalServices:[SERVICE]});
    device.addEventListener('gattserverdisconnected',onDisconnected);
    toast('Connecting…',true);
    gatt=await device.gatt.connect();
    const svc=await gatt.getPrimaryService(SERVICE);
    cmd=await svc.getCharacteristic(COMMAND);
    statusChar=await svc.getCharacteristic(STATUS);
    dataChar=await svc.getCharacteristic(DATA);
    await statusChar.startNotifications();
    await dataChar.startNotifications();
    statusChar.addEventListener('characteristicvaluechanged',e=>feedStatus(dec.decode(e.target.value)));
    dataChar.addEventListener('characteristicvaluechanged',e=>onData(new Uint8Array(e.target.value.buffer,e.target.value.byteOffset,e.target.value.byteLength)));
    await connectedStartup()
  }catch(e){setConnected(false);console.error('BLE connect failed',e);toast('Connect failed: '+(e&&e.message?e.message:String(e)),true)}
}
async function disconnect(){
  if(native){window.AndroidBridge.disconnect();return}
  try{if(live)await send('LIVE OFF')}catch(_){}
  if(device&&device.gatt&&device.gatt.connected)device.gatt.disconnect();else onDisconnected()
}
function onDisconnected(){transfer=null;liveRx=null;activeListPath=null;setConnected(false);toast('Disconnected')}

function feedStatus(c){
  statusBuf+=c;let i;
  while((i=statusBuf.indexOf('\n'))>=0){
    const line=statusBuf.slice(0,i).replace(/\r$/,'');
    statusBuf=statusBuf.slice(i+1);
    if(line)handleLine(line)
  }
}
function parseLiveInfo(line){const m={};line.replace(/([A-Za-z]+)=([^ ]+)/g,(_,k,v)=>(m[k]=v));if(m.camera){sensor=m.camera;$('sensorInfo').textContent=sensor}}
function handleLine(line){
  if(line.startsWith('LIVE INFO ')){parseLiveInfo(line);return}
  let m=line.match(/^LIVE ON (\S+) (\d+) (\d+) (\d+) (\d+)$/);if(m){live=true;updateLiveButton();showView('live');return}
  if(line==='LIVE OFF'){live=false;liveRx=null;updateLiveButton();showView('files');return}
  m=line.match(/^BEGIN LIVE (\d+) (\d+) (\d+) (\d+)(?: (\d+))?$/);if(m){beginLive(+m[1],+m[2],+m[3],+m[4]);return}
  m=line.match(/^END LIVE (\d+) (\d+)$/);if(m){endLive(+m[1],+m[2]);return}
  if(line.startsWith('ERR LIVE')){liveRx=null;toast(line,true);return}
  if(line.startsWith('BEGIN INDEX')){folders.clear();return}
  if(line.startsWith('I\tD\t')){const a=line.split('\t'),p=normalize(a[2]);folders.set(p,{dirs:+(a[3]||0),pics:+(a[4]||0),videos:+(a[5]||0),other:+(a[6]||0)});return}
  if(line.startsWith('END INDEX')){const m=line.match(/folders=(\d+).*pics=(\d+)/);$('folderValue').textContent=m?m[1]:folders.size;$('picValue').textContent=m?m[2]:'0';openFolder(currentPath);return}
  if(line.startsWith('BEGIN LIST ')){activeListPath=normalize(line.slice(11).trim());currentItems=[];return}
  if(/^[DPVF]\t/.test(line)&&activeListPath){const a=line.split('\t');currentItems.push({type:a[0],path:normalize(a[1]),size:+(a[2]||0)});return}
  if(line.startsWith('END LIST ')){activeListPath=null;render();return}
  if(line.startsWith('BEGIN GET ')){const m=line.match(/^BEGIN GET (.*) (\d+)$/);if(transfer&&m){transfer.expected=+m[2];progress()}return}
  if(line.startsWith('END GET ')){finishTransfer();return}
  if(line.startsWith('CANCEL GET')||line.startsWith('ERR ')){if(transfer){transfer=null;hideProgress()}toast(line,true);return}
}

function beginLive(id,size,w,h){liveRx={id:id&0xffff,expected:size,width:w,height:h,buf:new Uint8Array(size),next:0,bad:false}}
function onData(u){
  if(liveRx){
    if(u.length<6){liveRx.bad=true;return}
    const id=u[0]|(u[1]<<8),off=(u[2]|(u[3]<<8)|(u[4]<<16)|(u[5]<<24))>>>0,p=u.subarray(6);
    if(id!==liveRx.id)return;
    if(off!==liveRx.next)liveRx.bad=true;
    if(off+p.length>liveRx.expected){liveRx.bad=true;return}
    liveRx.buf.set(p,off);
    if(off===liveRx.next)liveRx.next+=p.length;
    return
  }
  if(transfer){
    if(u.length<4)return;
    const off=(u[0]|(u[1]<<8)|(u[2]<<16)|(u[3]<<24))>>>0,p=u.subarray(4);
    transfer.chunks.push({off,bytes:p.slice()});
    transfer.received+=p.length;
    progress()
  }
}
function endLive(id,bytes){
  if(!liveRx||((id&0xffff)!==liveRx.id)){liveRx=null;return}
  const r=liveRx;liveRx=null;
  if(r.bad||bytes!==r.expected||r.next!==r.expected)return;
  const blob=new Blob([r.buf],{type:'image/jpeg'}),url=URL.createObjectURL(blob);
  $('liveImage').src=url;$('liveView').classList.add('has');
  const old=liveObjectUrl;liveObjectUrl=url;if(old)setTimeout(()=>URL.revokeObjectURL(old),500)
}
async function toggleLive(){
  if(!connected)return;
  try{
    if(live){await send('LIVE OFF')}
    else{
      if(transfer){toast('Finish the current picture transfer first.');return}
      await send('LIVE SET '+LIVE_PROFILE+' '+LIVE_QUALITY+' '+LIVE_INTERVAL);
      await send('LIVE ON')
    }
  }catch(e){toast(e.message,true)}
}

function progress(){if(!transfer)return;$('progress').classList.add('show');const pct=transfer.expected?Math.min(100,transfer.received*100/transfer.expected):0;$('bar').style.width=pct+'%'}
function hideProgress(){$('progress').classList.remove('show');$('bar').style.width='0%'}
function assemble(){transfer.chunks.sort((a,b)=>a.off-b.off);const n=transfer.expected||transfer.chunks.reduce((n,c)=>Math.max(n,c.off+c.bytes.length),0),o=new Uint8Array(n);for(const c of transfer.chunks)o.set(c.bytes,c.off);return o}
function finishTransfer(){
  if(!transfer)return;
  const t=transfer,b=assemble();transfer=null;hideProgress();
  if(t.mode==='view'){
    if(previewUrl)URL.revokeObjectURL(previewUrl);
    previewUrl=URL.createObjectURL(new Blob([b],{type:'image/jpeg'}));
    $('previewImg').src=previewUrl;$('modalName').textContent=t.path;$('modal').classList.add('open')
  }else{
    const fn=basename(t.path);
    if(native){window.AndroidBridge.saveFile(fn,b64(b));toast('Saving '+fn+' to Downloads…',true)}
    else{
      const u=URL.createObjectURL(new Blob([b],{type:'image/jpeg'})),a=document.createElement('a');
      a.href=u;a.download=fn;document.body.appendChild(a);a.click();a.remove();
      setTimeout(()=>URL.revokeObjectURL(u),2000)
    }
  }
}
function getPicture(path,mode){if(live){toast('Stop Live before opening SD photos.');return}if(transfer){toast('A picture transfer is already running.');return}transfer={path,mode,expected:0,received:0,chunks:[]};progress();send('GET '+path)}
function childFolders(path){path=normalize(path);const a=[];for(const [p] of folders){if(p!=='/'&&p!==path&&parentOf(p)===path)a.push({type:'D',path:p,size:0})}return a.sort((a,b)=>a.path.localeCompare(b.path,undefined,{numeric:true}))}
function openFolder(path){if(live)return;currentPath=normalize(path);$('panelTitle').textContent=currentPath;setFileControlDisabled('upBtn',!connected||currentPath==='/');renderCrumbs();currentItems=[];render();if(connected)send('LIST '+currentPath)}
function renderCrumbs(){const c=$('crumbs');c.innerHTML='';const r=document.createElement('span');r.className='crumb';r.textContent='SD';r.onclick=()=>openFolder('/');c.appendChild(r);if(currentPath!=='/'){let cur='';for(const part of currentPath.split('/').filter(Boolean)){const s=document.createElement('span');s.className='sep';s.textContent='›';c.appendChild(s);cur+='/'+part;const e=document.createElement('span'),target=cur;e.className='crumb';e.textContent=part;e.onclick=()=>openFolder(target);c.appendChild(e)}}}
function render(){
  renderCrumbs();const el=$('list');el.innerHTML='';
  const all=childFolders(currentPath).concat(currentItems.filter(x=>x.type==='P').sort((a,b)=>a.path.localeCompare(b.path,undefined,{numeric:true})));
  $('empty').style.display=all.length?'none':'grid';
  $('empty').textContent=connected?'This folder is empty or still loading.':'Connect to the camera to browse the SD card.';
  for(const it of all){
    const d=document.createElement('div');d.className='item';
    if(it.type==='D'){
      const fm=folders.get(it.path),meta=fm?fm.pics+' pictures':'Folder';
      d.innerHTML='<div class="ico">📁</div><div><div class="name">'+esc(basename(it.path))+'</div><div class="meta">'+esc(meta)+'</div></div><div class="chev">›</div>';
      d.onclick=()=>openFolder(it.path)
    }else{
      d.innerHTML='<div class="ico">🖼️</div><div><div class="name">'+esc(basename(it.path))+'</div><div class="meta">'+esc(fmt(it.size))+'</div></div><div class="picActions"></div>';
      const a=d.querySelector('.picActions'),v=document.createElement('button'),dl=document.createElement('button');
      v.className=dl.className='mini';v.textContent='View';dl.textContent='Download';
      v.onclick=e=>{e.stopPropagation();getPicture(it.path,'view')};
      dl.onclick=e=>{e.stopPropagation();getPicture(it.path,'download')};
      a.append(v,dl)
    }
    el.appendChild(d)
  }
}
async function leaveLiveFor(v){if(live){try{await send('LIVE OFF')}catch(_){live=false;updateLiveButton()}setTimeout(()=>showView(v),40)}else showView(v)}

$('connectBtn').onclick=connect;
$('disconnectBtn').onclick=disconnect;
$('liveBtn').onclick=toggleLive;
$('filesTab').onclick=()=>leaveLiveFor('files');
$('infoTab').onclick=()=>leaveLiveFor('info');
$('upBtn').onclick=()=>{if(fileControlDisabled('upBtn'))return;const p=parentOf(currentPath);if(p)openFolder(p)};
$('refreshBtn').onclick=()=>{if(fileControlDisabled('refreshBtn'))return;openFolder(currentPath)};
$('reindexBtn').onclick=()=>{if(fileControlDisabled('reindexBtn'))return;if(live)return;folders.clear();currentItems=[];$('folderValue').textContent='0';$('picValue').textContent='0';render();send('INDEX')};
$('closeModal').onclick=()=>$('modal').classList.remove('open');
$('modal').onclick=e=>{if(e.target===$('modal'))$('modal').classList.remove('open')};

window.onNativeConnected=()=>{connectedStartup()};
window.onNativeDisconnected=onDisconnected;
window.onNativeStatus=feedStatus;
window.onNativeDataRaw=s=>{try{const bin=atob(s),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);onData(u)}catch(e){console.error(e)}};
window.onNativeMessage=s=>{if(!s)return;if(s.startsWith('Saved ')){toast(s);return}if(s.startsWith('Scanning')||s.startsWith('Connecting')||s.startsWith('Connected'))toast(s,true);else toast(s)};

setConnected(false);renderCrumbs();render();showView('files');
})();
</script>
</body>
</html>