# Arduino framework
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP32-S3 N16R8: 16 MB flash + 8 MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Large single factory app for camera + BLE + USB firmware
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# exFAT prerequisites
CONFIG_FATFS_LFN_HEAP=y
# CONFIG_FATFS_LFN_NONE is not set
# CONFIG_FATFS_LFN_STACK is not set
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Native TinyUSB MSC
CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
# Keep native USB as MSC only; UART0 remains the diagnostic Serial port.
# CONFIG_TINYUSB_CDC_ENABLED is not set
# CONFIG_TINYUSB_HID_ENABLED is not set
# CONFIG_TINYUSB_MIDI_ENABLED is not set
# CONFIG_TINYUSB_AUDIO_ENABLED is not set
# CONFIG_TINYUSB_VIDEO_ENABLED is not set
# CONFIG_TINYUSB_DFU_RT_ENABLED is not set
# CONFIG_TINYUSB_DFU_ENABLED is not set
# CONFIG_TINYUSB_VENDOR_ENABLED is not set
# CONFIG_TINYUSB_NCM_ENABLED is not set

# BLE: preserve the Arduino BLE API used by the existing firmware.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y

# Camera JPEG buffer sizing
# QSXGA 2560x1920 JPEG Q4 can exceed the esp32-camera automatic width*height/5
# allocation (983,040 bytes). Use a fixed 2.5 MiB JPEG buffer per frame instead.
# CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_AUTO is not set
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=2621440
